# Server configuration
PORT=5000

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Mandatory for backend server-side ingestion)
# - Grants minimum required permissions strictly to the backend server
# - Telemetry writes & reads bypass client-side access
# - NEVER expose this key to frontend client applications or public code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

