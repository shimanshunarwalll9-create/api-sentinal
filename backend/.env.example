# Server configuration
PORT=5000

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Use your Supabase Service Role Key (recommended for server-side inserts bypassing RLS)
# or your anon key if RLS policies allow INSERT on api_requests.
# Keep this secret and NEVER expose it to frontend client code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional alternative if using Anon public key
SUPABASE_ANON_KEY=your-supabase-anon-key
